  var last = sh.getLastRow() >= REPORT_FIRST_ROW ? sh.getRange(sh.getLastRow(), 1).getValue() : '';
  var lastIso = isDate_(last) ? isoOf_(last) : typeof last === 'number' ? isoFromSerial_(last) : null;
  if (!lastIso || lastIso !== todayIso_()) refresh_();
