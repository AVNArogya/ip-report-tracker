    });
    var perRoom = rows.length > 0 && rows.every(function (r) { return !roomName(r[4]) && roomName(r[1]); });
    var defaults = {};
    DEFAULT_CATEGORIES.forEach(function (d) { defaults[d[0].toLowerCase()] = d; });
    var cats = [], byName = {};
